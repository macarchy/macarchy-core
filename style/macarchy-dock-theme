#!/bin/bash
# Regenerate the nwg-dock stylesheet from the current Omarchy theme, then
# reload the running dock. Installed as a theme-set hook, so the dock follows
# every theme change rather than being pinned to whichever one was active when
# it was set up.
set -uo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
CSS="${XDG_CONFIG_HOME:-$HOME/.config}/nwg-dock-hyprland/style.css"
[[ -f $COLORS ]] || exit 0

c() { omarchy-theme-color --file "$COLORS" "$1" 2>/dev/null; }

mode=$(c mode)
accent=$(c accent)
fg=$(c foreground)

# The dock is a glass pane like every other surface, so it carries the surface
# colour at low alpha and lets Hyprland's layer blur do the work. On light
# themes the pane sits brighter than the wallpaper and the rim inverts to a
# shadow, exactly as in the themes' hyprland.lua.
if [[ $mode == "light" ]]; then
  pane="255, 255, 255"; pane_a=0.72
  rim="rgba(0, 0, 0, 0.10)"
  hover="rgba(0, 0, 0, 0.08)"
else
  pane="29, 29, 31"; pane_a=0.55
  rim="rgba(255, 255, 255, 0.16)"
  hover="rgba(255, 255, 255, 0.12)"
fi

cat > "$CSS" <<EOF
/* Generated by macarchy-dock-theme -- edits here are overwritten on theme set. */
window {
  background: rgba($pane, $pane_a);
  border-radius: 20px;
  border: 1px solid $rim;
}

#box { padding: 8px; }

button, image {
  background: none;
  border-style: none;
  box-shadow: none;
  color: $fg;
}

button {
  padding: 6px;
  margin-left: 3px;
  margin-right: 3px;
  border-radius: 12px;
  font-size: 12px;
}

button:hover { background-color: $hover; }
button:focus { box-shadow: none; }

/* nwg-dock draws its own macOS-style dot under each running instance, in a
   colour hardcoded in the binary -- neither a color property on #running nor
   a CSS background reaches it. It stays teal regardless of theme; noted rather than
   worked around, because a CSS rule that does nothing is worse than none. */

/* The focused app's tile. */
#active {
  background-color: $hover;
}
EOF

# nwg-dock re-reads its CSS only at startup, so reloading means restarting it.
#
# Matched on process NAME, never with -f. `pkill -f nwg-dock-hyprland` matches
# any process whose command line merely mentions the name -- including the
# shell that invoked this script, which is an easy way to kill your own caller.
# The binary also rewrites its own argv, so an anchored path pattern misses it.
if pgrep -x nwg-dock-hyprla >/dev/null; then
  pkill -x nwg-dock-hyprla
  sleep 0.4
  setsid "$HOME/.local/bin/macarchy-dock" >/dev/null 2>&1 &
fi
exit 0
