#!/bin/bash
# Keep GTK's settings.ini in step with the current Omarchy theme.
#
# Omarchy sets gtk-theme / icon-theme through gsettings, which GTK only honours
# when an XSETTINGS manager is running. Under Hyprland there usually isn't one,
# so GTK reads ~/.config/gtk-{3.0,4.0}/settings.ini instead -- and a settings.ini
# that omits these keys silently pins every GTK app to the stock Adwaita icon
# set. Writing them here is what makes the theme actually reach GTK apps, the
# dock's icons included.
set -uo pipefail

COLORS="$HOME/.local/state/omarchy/current/theme/colors.toml"
ICONS="$HOME/.local/state/omarchy/current/theme/icons.theme"
[[ -f $COLORS ]] || exit 0

mode=$(omarchy-theme-color --file "$COLORS" mode 2>/dev/null)
icon_theme=$([[ -f $ICONS ]] && cat "$ICONS" || echo "Yaru-blue")
[[ $mode == "light" ]] && gtk_theme="Adwaita" || gtk_theme="Adwaita-dark"

for d in gtk-3.0 gtk-4.0; do
  dir="${XDG_CONFIG_HOME:-$HOME/.config}/$d"
  mkdir -p "$dir"
  cat > "$dir/settings.ini" <<EOF
# Generated by omarchy-gtk-settings on theme set -- edits here are overwritten.
[Settings]
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=$icon_theme
gtk-cursor-theme-name=macOS
gtk-cursor-theme-size=24
gtk-font-name=Inter 11
EOF
done
exit 0
