[Unit]
Description=Pick the transparent bar's text colour from what is on screen
After=graphical-session.target
PartOf=graphical-session.target

# This reads the screen that those two units repaint. All three used to fire on
# the same five-minute boundary, so a grab could land on the outgoing frame and
# park the bar on the previous theme's colour for a whole period. Order behind
# the producers whenever the jobs are queued together; the timer's :30 offset
# and the tool's own settling cover the rest.
After=macarchy-auto-appearance.service macarchy-dynamic-wallpaper.service

# A contrast job that dies silently looks exactly like a bar that picked the
# wrong colour, which is how it went unnoticed on 2026-09-04. The notifier is
# shared and ships from macarchy-install.
OnFailure=macarchy-failed@%n.service

[Service]
Type=oneshot
ExecStart=%h/.local/bin/macarchy-bar-contrast
